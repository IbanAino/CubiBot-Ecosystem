<?xml version="1.0"?>
<robot name="simple_robot">

  <!-- 1. La Racine Absolue du Robot (au sol, entre les roues) -->
  <link name="base_footprint"/>

  <!-- 2. On attache le base_link 2.15 cm plus haut (Hauteur du rayon des roues) -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0215" rpy="0 0 0"/> <!-- 0.02m correspond au rayon de vos roues -->
  </joint>

  <!-- 3. Le repère central physique -->
  <link name="base_link"/>

  <!-- 4. Fixer le châssis par rapport à base_link -->
  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <!-- Comme base_link est déjà à +2cm, on monte le châssis de 4cm supplémentaires -->
    <origin xyz="0 0 0.043" rpy="0 0 0"/>
  </joint>
  
  <!-- Châssis -->
  <link name="chassis">
    <visual>
      <geometry>
        <box size="0.11 0.11 0.11"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.11 0.11 0.11"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <!-- Roue gauche -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.0215" length="0.019"/>
      </geometry>
      <!-- Couleur définie explicitement dans chaque link pour garantir
           l'affichage correct dans RViz et Gazebo -->
      <material name="black_left">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0215" length="0.019"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="left_wheel"/>
    <origin xyz="0.03 0.065 -0.04" rpy="-1.5708 0 0"/>
    <!-- L'axe de rotation du cylindre est Z local, mis en Y monde
         après la rotation RPY ci-dessus -->
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Roue droite -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.0215" length="0.019"/>
      </geometry>
      <!-- Couleur redéfinie explicitement — ne pas réutiliser
           <material name="black"/> sans rgba dans un autre link -->
      <material name="black_right">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0215" length="0.019"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="right_wheel"/>
    <origin xyz="0.03 -0.065 -0.04" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Roue folle (caster) -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.016"/>
      </geometry>
      <material name="black_caster">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.016"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="chassis"/>
    <child link="caster_wheel"/>
    <!-- 0.06 (hauteur chassis) - 0.044 = 0.016 = rayon sphère → touche le sol -->
    <origin xyz="-0.035 0 -0.044" rpy="0 0 0"/>
  </joint>

  <!-- Lidar 2D -->
  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.02"/>
      </geometry>
      <material name="black_lidar">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.02 0.02 0.1" rpy="0.0 3.14159265 1.5708"/>
  </joint>

</robot>

